@inject BoardState State
@inject AppController App
@inject PlaybackService Playback
@implements IDisposable

@if (State.Playback.Active)
{
    <div class="playback" id="playback">
        <button class="btn btn--icon" title="暂停/继续" aria-label="暂停或继续" @onclick="() => App.TogglePause()">
            <svg class="icon"><use href="@(State.Playback.Paused ? "#i-play" : "#i-stop")"></use></svg>
        </button>
        <input type="range" id="playScrub" min="0" max="1000" value="@ScrubValue" aria-label="回放进度"
               @oninput="OnScrub" style="@($"--fill: {ScrubValue / 10.0}%")" />
        <span class="playback__time">@Num.FormatTime(State.Playback.T) / @Num.FormatTime(State.Playback.Duration)</span>
        <select class="playback__speed" aria-label="回放速度" @onchange="OnSpeedChange">
            <option value="0.5" selected="@(Math.Abs(State.Playback.Speed - 0.5) < 0.001)">0.5×</option>
            <option value="1" selected="@(Math.Abs(State.Playback.Speed - 1) < 0.001)">1×</option>
            <option value="2" selected="@(Math.Abs(State.Playback.Speed - 2) < 0.001)">2×</option>
            <option value="4" selected="@(Math.Abs(State.Playback.Speed - 4) < 0.001)">4×</option>
        </select>
        <button class="btn btn--icon" title="退出回放" aria-label="退出回放" @onclick="() => App.StopPlayback()">
            <svg class="icon"><use href="#i-close"></use></svg>
        </button>
    </div>
}

@code {
    private int ScrubValue =>
        State.Playback.Duration > 0 ? (int)Math.Round(State.Playback.T / State.Playback.Duration * 1000) : 0;

    protected override void OnInitialized()
    {
        Playback.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnScrub(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            App.SeekPlayback(value / 1000.0);
        }
    }

    private void OnSpeedChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            App.SetPlaybackSpeed(value);
        }
    }

    public void Dispose()
    {
        Playback.Changed -= OnChanged;
    }
}
