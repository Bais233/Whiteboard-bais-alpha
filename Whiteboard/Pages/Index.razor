@page "/"
@implements IDisposable

<IconSprite />

<div class="app" data-theme="@State.Ui.Theme">
    <canvas id="board" class="board" tabindex="0" aria-label="白色画板，可用键盘与鼠标绘制"
            @ref="_canvas" data-tool="@State.Tool"></canvas>

    <!-- ===== 顶部状态条 ===== -->
    <header class="topbar" id="topbar">
        <div class="topbar__brand" title="Whiteboard bais alpha">
            <span class="dot"></span>
            <span class="topbar__title">白色画板</span>
            <span class="topbar__sub">bais · alpha</span>
        </div>

        <div class="topbar__group" role="group" aria-label="历史">
            <button type="button" class="btn btn--icon" id="btnUndo" title="撤销 (Ctrl+Z)" aria-label="撤销"
                    disabled="@(!App.CanUndo)" @onclick="App.Undo">
                <svg class="icon"><use href="#i-undo"></use></svg>
            </button>
            <button type="button" class="btn btn--icon" id="btnRedo" title="重做 (Ctrl+Y)" aria-label="重做"
                    disabled="@(!App.CanRedo)" @onclick="App.Redo">
                <svg class="icon"><use href="#i-redo"></use></svg>
            </button>
        </div>

        <div class="topbar__group topbar__group--view" role="group" aria-label="视图">
            <button type="button" class="btn btn--icon" id="btnZoomOut" title="缩小 (−)" aria-label="缩小" @onclick="() => App.ZoomOut()">
                <svg class="icon"><use href="#i-zoom-out"></use></svg>
            </button>
            <ZoomLabel />
            <button type="button" class="btn btn--icon" id="btnZoomIn" title="放大 (+)" aria-label="放大" @onclick="() => App.ZoomIn()">
                <svg class="icon"><use href="#i-zoom-in"></use></svg>
            </button>
            <button type="button" class="btn btn--icon" id="btnFit" title="适应内容 (1)" aria-label="适应内容" @onclick="() => App.FitToContent(60)">
                <svg class="icon"><use href="#i-fit"></use></svg>
            </button>
            <button type="button" class="btn btn--icon" id="btnGrid" title="网格 (G)" aria-label="网格"
                    aria-pressed="@(State.Board.Grid != "none" ? "true" : "false")" @onclick="App.CycleGrid">
                <svg class="icon"><use href="#i-grid"></use></svg>
            </button>
            <button type="button" class="btn btn--icon" id="btnSnap" title="对齐网格 (Shift+G)" aria-label="对齐网格"
                    aria-pressed="@(State.Board.Snap ? "true" : "false")" @onclick="App.ToggleSnap">
                <svg class="icon"><use href="#i-magnet"></use></svg>
            </button>
        </div>

        <div class="topbar__group" role="group" aria-label="录制与回放">
            <button type="button" class="btn btn--icon btn--record" id="btnRecord" title="开始/停止计时录制 (F9)"
                    aria-label="录制" aria-pressed="@(State.Session.Recording ? "true" : "false")" @onclick="App.ToggleRecording">
                <svg class="icon"><use href="#i-record"></use></svg>
            </button>
            <RecordClock />
            <button type="button" class="btn btn--icon" id="btnPlay" title="回放笔迹 (F10)" aria-label="回放" @onclick="App.TogglePlayback">
                <svg class="icon"><use href="#i-play"></use></svg>
            </button>
        </div>

        <div class="topbar__group topbar__group--right" role="group" aria-label="文件">
            <button type="button" class="btn btn--icon" id="btnMath" title="数学符号面板 (M)" aria-label="数学符号"
                    aria-pressed="@(App.MathOpen ? "true" : "false")" @onclick="App.ToggleMathPanel">
                <svg class="icon"><use href="#i-fx"></use></svg>
            </button>
            <button type="button" class="btn btn--icon desktop-only" id="btnHelp" title="帮助与快捷键 (?)" aria-label="帮助" @onclick="App.ToggleHelp">
                <svg class="icon"><use href="#i-help"></use></svg>
            </button>
            <div class="menu-wrap">
                <button type="button" class="btn btn--icon" id="btnMenu" title="更多操作" aria-label="更多操作"
                        aria-haspopup="true" aria-expanded="@(_fileMenuOpen ? "true" : "false")" @onclick="ToggleMenu">
                    <svg class="icon"><use href="#i-menu"></use></svg>
                </button>
            </div>
        </div>
    </header>

    @if (_fileMenuOpen)
    {
        <div class="menu-backdrop" @onclick="CloseMenu"></div>
        <div class="menu menu--portal" id="fileMenu" role="menu">
            <button type="button" class="menu__item" role="menuitem" @onclick="SaveJsonAsync">
                <svg class="icon"><use href="#i-download"></use></svg>导出为 .wbjson 工程
            </button>
            <button type="button" class="menu__item" role="menuitem" @onclick="OpenJsonAsync">
                <svg class="icon"><use href="#i-upload"></use></svg>导入 .wbjson 工程
            </button>
            <button type="button" class="menu__item" role="menuitem" @onclick="ExportPngAsync">
                <svg class="icon"><use href="#i-download"></use></svg>导出 PNG 图片
            </button>
            <button type="button" class="menu__item" role="menuitem" @onclick="ExportSvgAsync">
                <svg class="icon"><use href="#i-download"></use></svg>导出 SVG 矢量图
            </button>
            <button type="button" class="menu__item" role="menuitem" @onclick="PrintAsync">
                <svg class="icon"><use href="#i-download"></use></svg>打印 / 存为 PDF
            </button>
            <div class="menu__sep"></div>
            <button type="button" class="menu__item" role="menuitem" @onclick="BoardWhiteAsync">
                <svg class="icon"><use href="#i-fill"></use></svg>板面：纯白
            </button>
            <button type="button" class="menu__item" role="menuitem" @onclick="BoardEyeAsync">
                <svg class="icon"><use href="#i-fill"></use></svg>板面：护眼米色
            </button>
            <button type="button" class="menu__item" role="menuitem" @onclick="BoardDarkAsync">
                <svg class="icon"><use href="#i-fill"></use></svg>板面：深色（墨板）
            </button>
            <div class="menu__sep"></div>
            <button type="button" class="menu__item" role="menuitem" @onclick="InstallPwaAsync">
                <svg class="icon"><use href="#i-install"></use></svg>安装到主屏幕
            </button>
            <button type="button" class="menu__item" role="menuitem" @onclick="HelpAsync">
                <svg class="icon"><use href="#i-help"></use></svg>帮助与快捷键
            </button>
            <div class="menu__sep"></div>
            <button type="button" class="menu__item menu__item--danger" role="menuitem" @onclick="ClearBoardAsync">
                <svg class="icon"><use href="#i-trash"></use></svg>清空白板
            </button>
        </div>
    }

    <!-- ===== 悬浮工具条 ===== -->
    <aside class="panel toolbar desktop-only @(App.ToolsCollapsed ? "is-collapsed" : "")" id="toolbar" style="left:16px; top:76px;">
        <div class="panel__grip" data-drag-handle title="拖动工具条">
            <svg class="icon icon--sm"><use href="#i-grip"></use></svg>
            <span class="panel__grip-label">工具</span>
            <button type="button" class="btn btn--icon btn--xs" id="btnCollapseTools" title="折叠/展开 (Ctrl+B)"
                    aria-label="折叠工具条" @onclick="App.ToggleTools">
                <svg class="icon icon--collapse"><use href="#i-chevron"></use></svg>
            </button>
        </div>
        <div class="toolbar__body" id="toolbarBody">
            <div class="tool-grid" id="toolGrid" role="toolbar" aria-label="绘制工具">
                @foreach (var tool in ToolsService.ToolList)
                {
                    <button type="button" class="btn btn--tool" title="@($"{tool.Name} ({tool.Key})\n{tool.Hint}")"
                            aria-pressed="@(State.Tool == tool.Id ? "true" : "false")" @onclick="() => App.SetTool(tool.Id)">
                        <svg class="icon"><use href="@($"#{tool.Icon}")"></use></svg>
                        <span>@tool.Name</span>
                    </button>
                }
            </div>
            <div class="toolbar__divider"></div>
            <div class="quick" id="quickActions">
                <button type="button" class="btn btn--icon" title="撤销" @onclick="App.Undo"><svg class="icon"><use href="#i-undo"></use></svg></button>
                <button type="button" class="btn btn--icon" title="重做" @onclick="App.Redo"><svg class="icon"><use href="#i-redo"></use></svg></button>
                <button type="button" class="btn btn--icon" title="复制选中 (Ctrl+D)" @onclick="App.DuplicateSelection"><svg class="icon"><use href="#i-copy"></use></svg></button>
                <button type="button" class="btn btn--icon" title="置于顶层" @onclick="ReorderFront"><svg class="icon"><use href="#i-front"></use></svg></button>
                <button type="button" class="btn btn--icon" title="置于底层" @onclick="ReorderBack"><svg class="icon"><use href="#i-back"></use></svg></button>
                <button type="button" class="btn btn--icon btn--danger" title="删除选中 (Del)" @onclick="App.DeleteSelection"><svg class="icon"><use href="#i-trash"></use></svg></button>
            </div>
        </div>
    </aside>

    <!-- ===== 样式面板 ===== -->
    <aside class="panel stylebar desktop-only" id="stylebar" style="left:16px; bottom:56px;">
        <div class="panel__grip" data-drag-handle title="拖动样式面板">
            <svg class="icon icon--sm"><use href="#i-grip"></use></svg>
            <span class="panel__grip-label">样式</span>
        </div>
        <div class="stylebar__body">
            <StyleControls />
        </div>
    </aside>

    <MathPanel />
    <PlaybackBar />
    <StatusBar />
    <MobileDock />
    <MobileSheets />

    <!-- ===== 帮助弹窗 ===== -->
    @if (App.HelpOpen)
    {
        <div class="modal" id="helpModal">
            <div class="modal__scrim" @onclick="App.CloseHelp"></div>
            <div class="modal__card" role="dialog" aria-modal="true" aria-labelledby="helpTitle">
                <header class="modal__head">
                    <h2 id="helpTitle">帮助与快捷键</h2>
                    <button type="button" class="btn btn--icon" title="关闭" aria-label="关闭" @onclick="App.CloseHelp">
                        <svg class="icon"><use href="#i-close"></use></svg>
                    </button>
                </header>
                <div class="modal__body">
                    <section>
                        <h3>绘制</h3>
                        <ul class="keys" id="helpTools">
                            @foreach (var tool in ToolsService.ToolList)
                            {
                                <li><span><kbd>@tool.Key</kbd></span><em>@tool.Name：@tool.Hint</em></li>
                            }
                        </ul>
                    </section>
                    <section>
                        <h3>画布操作</h3>
                        <ul class="keys">
                            <li><span><kbd>Space</kbd> + 拖动 / 中键拖动 / 双指拖动</span><em>平移画布</em></li>
                            <li><span><kbd>滚轮</kbd> / <kbd>Ctrl</kbd>+<kbd>滚轮</kbd> / 双指捏合</span><em>缩放</em></li>
                            <li><span><kbd>+</kbd> <kbd>−</kbd> <kbd>0</kbd> <kbd>1</kbd></span><em>放大 / 缩小 / 100% / 适应内容</em></li>
                            <li><span><kbd>Alt</kbd> + 拖动</span><em>临时平移</em></li>
                        </ul>
                    </section>
                    <section>
                        <h3>编辑与文件</h3>
                        <ul class="keys">
                            <li><span><kbd>Ctrl</kbd>+<kbd>Z</kbd> / <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>Z</kbd></span><em>撤销 / 重做</em></li>
                            <li><span><kbd>Ctrl</kbd>+<kbd>D</kbd> / <kbd>Ctrl</kbd>+<kbd>A</kbd></span><em>复制选中 / 全选</em></li>
                            <li><span><kbd>Delete</kbd></span><em>删除选中</em></li>
                            <li><span><kbd>方向键</kbd></span><em>微调选中（Shift 为 10 倍）</em></li>
                            <li><span><kbd>Ctrl</kbd>+<kbd>S</kbd> / <kbd>Ctrl</kbd>+<kbd>P</kbd></span><em>导出 .wbjson / 打印</em></li>
                            <li><span><kbd>G</kbd> <kbd>M</kbd> <kbd>F9</kbd> <kbd>F10</kbd> <kbd>?</kbd></span><em>网格 / 数学面板 / 录制 / 回放 / 帮助</em></li>
                        </ul>
                    </section>
                    <section>
                        <h3>数学草稿</h3>
                        <p>数学面板把常见 LaTeX 速记转换为 Unicode 文本，无需联网、无需公式渲染引擎。例如
                            <code>\frac{-b \pm \sqrt{b^2-4ac}}{2a}</code> 会变成可编辑的一行文本，落板后仍可用文字工具修改。</p>
                    </section>
                </div>
            </div>
        </div>
    }

    <ToastHost />

    <InputFile id="fileInput" OnChange="OnFileSelected" accept=".wbjson,.json,application/json" style="display:none" />
</div>

@code {
    private ElementReference _canvas;
    private bool _fileMenuOpen;
    private bool _disposed;

    [Inject] private BoardState State { get; set; } = default!;
    [Inject] private AppController App { get; set; } = default!;

    protected override void OnInitialized()
    {
        State.ToolChanged += OnChanged;
        State.StyleChanged += OnChanged;
        State.BoardChanged += OnChanged;
        State.RecordingChanged += OnChanged;
        State.UiChanged += OnChanged;
        App.HistoryStateChanged += OnChanged;
        App.DocumentReloaded += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await App.InitializeAsync(_canvas);
        if (!_disposed) StateHasChanged();
    }

    private void OnChanged()
    {
        if (_disposed) return;
        if (_fileMenuOpen && (App.MobilePanel != "none" || App.MathOpen)) _fileMenuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu()
    {
        _fileMenuOpen = !_fileMenuOpen;
        if (_fileMenuOpen)
        {
            App.CloseMobilePanel();
            App.CloseMathPanel();
        }
    }

    private void CloseMenu() => _fileMenuOpen = false;

    private async Task RunMenuAsync(string act)
    {
        _fileMenuOpen = false;
        await App.RunActionAsync(act);
    }

    private Task SaveJsonAsync() => RunMenuAsync("save-json");
    private Task OpenJsonAsync() => RunMenuAsync("open-json");
    private Task ExportPngAsync() => RunMenuAsync("export-png");
    private Task ExportSvgAsync() => RunMenuAsync("export-svg");
    private Task PrintAsync() => RunMenuAsync("print");
    private Task BoardWhiteAsync() => RunMenuAsync("board-white");
    private Task BoardEyeAsync() => RunMenuAsync("board-eye");
    private Task BoardDarkAsync() => RunMenuAsync("board-dark");
    private Task InstallPwaAsync() => RunMenuAsync("install-pwa");
    private Task HelpAsync() => RunMenuAsync("help");
    private Task ClearBoardAsync() => RunMenuAsync("clear");

    private void ReorderFront() => App.Reorder("front");
    private void ReorderBack() => App.Reorder("back");

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        try
        {
            await using var stream = file.OpenReadStream(20 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            await App.ImportJsonAsync(await reader.ReadToEndAsync());
        }
        catch (Exception ex)
        {
            App.NotifyError($"导入失败：{ex.Message}");
        }
    }

    public void Dispose()
    {
        _disposed = true;
        State.ToolChanged -= OnChanged;
        State.StyleChanged -= OnChanged;
        State.BoardChanged -= OnChanged;
        State.RecordingChanged -= OnChanged;
        State.UiChanged -= OnChanged;
        App.HistoryStateChanged -= OnChanged;
        App.DocumentReloaded -= OnChanged;
    }
}
